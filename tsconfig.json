{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": [
        "server/**/*",
        "shared/**/*",
        "jest.setup.d.ts"
    ],
    "exclude": [
        "node_modules",
        "public"
    ]
}