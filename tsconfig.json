{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@jungeon/shared": ["packages/shared/src"],
            "@jungeon/shared/*": ["packages/shared/src/*"],
            "@jungeon/client-core": ["packages/client-core/src"],
            "@jungeon/client-core/*": ["packages/client-core/src/*"]
        }
    },
    "include": [
        "server/**/*",
        "shared/**/*",
        "packages/**/*",
        "jest.setup.d.ts"
    ],
    "exclude": [
        "node_modules",
        "public"
    ]
}